---
Checks: '-*,bugprone-*,clang-analyzer-*,concurrency-*,performance-*,readability-identifier-naming'
WarningsAsErrors: 'bugprone-*,clang-analyzer-*,concurrency-*'
HeaderFilterRegex: 'robot_template/'
FormatStyle: 'file'
CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack